from typing import Sequence,Set
from ..common.types import Symbol
from .lr0_parser import LR0Item

class LR1Item(LR0Item):

    def __init__(self, head: Symbol, left: Sequence[Symbol], right: Sequence[Symbol],lookahead:Symbol): ...
    
    @property
    def lookahead(self) -> Symbol: ...
    
    def __str__(self) -> str: ...
    
    def __repr__(self) -> str: ...
    
    def __eq__(self, __o: object) -> bool: ...

    def __hash__(self) -> int: ...

class LR1State:
    
    def __init__(self,items:Set[LR1Item],index:int=0): ...
    
    @property
    def id(self) -> str: ...
    
    @property
    def index(self) -> int: ...

    @property
    def items(self) -> Set[LR1Item]: ...

    def __eq__(self, __o: object) -> bool: ...
    
    def __hash__(self) -> int: ...