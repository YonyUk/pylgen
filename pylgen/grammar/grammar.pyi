from typing import Callable, Dict, List, Set, Tuple

from ..common.types import AST, Symbol, ASTListView

class SymbolNotPresentInGrammarException(Exception):
    
    def __init__(self,symbol:Symbol,*args) -> None: ...

class Production:

    def __init__(self,head:Symbol,production:List[Symbol]): ...
    
    @property
    def id(self) -> str: ...
    
    @property
    def head(self) -> Symbol: ...
    
    @property
    def production(self) -> List[Symbol]: ...
    
    def __str__(self) -> str: ...
    
    def __repr__(self) -> str: ...
    
    def __eq__(self, o) -> bool: ...
    
    def __hash__(self) -> int: ...

class ProductionsSet:

    def __init__(self): ...
    
    @property
    def productions(self) -> List[List[Symbol]]: ...
    
    def __iadd__(self,production:Tuple[Symbol,...]) -> ProductionsSet: ...

class AttributedProductionsSet(ProductionsSet):
    
    def __iadd__(self, production_redutor_pair:Tuple[Tuple[Symbol, ...],Callable[[ASTListView],AST]]) -> AttributedProductionsSet: ... # type:ignore

class Grammar:

    def __init__(self,start_symbol:Symbol,end_symbol:str='\x00'): ...
    
    @property
    def id(self) -> str: ...

    @property
    def productions(self) -> Set[Production]: ...
    
    @property
    def terminals(self) -> Set[Symbol]: ...
    
    @property
    def non_terminals(self) -> Set[Symbol]: ...

    @property
    def symbols(self) -> Set[Symbol]: ...
    
    @property
    def start_symbol(self) -> Symbol: ...

    @property
    def end_symbol(self) -> Symbol: ...

    @staticmethod
    def IsLeftRegular(g:Grammar) -> bool: ...
    
    @staticmethod
    def IsRightRegular(g:Grammar) -> bool: ...
    
    @staticmethod
    def IsRegular(g:Grammar) -> bool: ...

    @staticmethod
    def AugmentGrammar(g:Grammar) -> Grammar: ...

    @staticmethod
    def Reverse(g:Grammar) -> Grammar: ...

    def first(self,production:List[Symbol]) -> Set[Symbol]: ...

    def follow(self,symbol:Symbol) -> Set[Symbol]: ...

    def to_dict(self) -> Dict: ...

    def __getitem__(self,head:Symbol) -> ProductionsSet: ...
    
    def __setitem__(self,head:Symbol,productions:ProductionsSet) -> None: ...

class AttributedGrammar(Grammar):

    def get_reductor(self,production:Production) -> Callable[[List[AST]],AST]: ...

    def __getitem__(self,head:Symbol) -> AttributedProductionsSet: ...

    def __setitem__(self,head:Symbol,productions:AttributedProductionsSet) -> None: ... # type:ignore