from typing import Tuple,List,Dict

class Table:

    def __init__(self):
        self._table = {}
    
    @property
    def entries(self) -> List[Tuple[str,str]]: ...

    @property
    def values(self) -> List[str]: ...

    @property
    def items(self) -> List[Tuple[str,str,str]]: ...
    
    def to_dict(self) -> Dict[Tuple[str,str],str]: ...
    
    def from_dict(self, data: Dict[Tuple[str, str], str]) -> None: ...

    def __getitem__(self, coord: Tuple[str, str]) -> str: ...

    def __setitem__(self, coord: Tuple[str, str], value: str) -> None: ...

    def __delitem__(self, coord: Tuple[str, str]) -> None: ...