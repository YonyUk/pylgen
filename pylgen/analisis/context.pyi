from typing import List
from .error import SemanticError,RuntimeError
from ..common.types import AST

class Context:

    def __init__(self) -> None: ...

    @property
    def errors(self) -> list[SemanticError | RuntimeError]: ...

    @property
    def stack_trace(self) -> List[str]: ...
    
    def push_trace(self,trace:str) -> None: ...
    
    def pop_trace(self) -> None: ...
    
    def push_new_scope(self) -> None: ...
    
    def pop_scope(self) -> None: ...

    def clear_runtime_errors(self) -> None: ...

    def clear_semantic_errors(self) -> None: ...
    
    def reset(self) -> None: ...

    def clear_errors(self) -> None: ...

    def add_semantic_error(self, error:SemanticError) -> None: ...
    
    def add_runtime_error(self, ast:AST, error:RuntimeError) -> None: ...

    def get_runtime_errors(self) -> List[RuntimeError]: ...