{% set ns = namespace(
    sections_deep={},
    sections_name={},
    sections_title={},
    last_file=None,
    last_section=None
) %}
{% include "_nav_map.j2" %}
{{ data.toc_output_comment }}

{% if data.page_description %}
{{ data.page_description }}
{% endif %}

{% for header in data.toc_headers %}
{% set file_path = header.url.split('#')[0] %}
{% set deep = ns.sections_deep.get(file_path, 1) %}
{% set section = ns.sections_name.get(file_path, '') %}
{% set page_title = ns.sections_title.get(file_path, '') %}

{% if file_path != ns.last_file %}
{# --- Primera cabecera de una nueva página --- #}
{% if section and section != ns.last_section %}
{% set ns.last_section = section %}
{{ '#' * (deep - 1 if deep > 1 else 1) }} **{{ section }}**
{% endif %}
{% if header.level == 1 %}
{{ '#' * (deep if deep > 1 else 1) }} **[{{ header.text }}]({{ header.url }})**
{% else %}
{{ '#' * (deep if deep > 1 else 1) }} **[{{ page_title }}]({{ file_path }})**
- [{{ header.text }}]({{ header.url }})
{% endif %}
{% set ns.last_file = file_path %}
{% else %}
{% if header.level == 1 %}
{{ '#' * (deep + 1) }} **[{{ header.text }}]({{ header.url }})**
{% elif header.level == 2 %}
- [{{ header.text }}]({{ header.url }})
{% else %}
{% set indent = '    ' * (header.level - 3) %}
{{ indent }}- [{{ header.text }}]({{ header.url }})
{% endif %}
{% endif %}
{% endfor %}